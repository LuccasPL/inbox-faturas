# Template only. Keep real values in .env.local or the deployment platform.
# Database and authentication
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Inbound processing (Anthropic + Postmark Basic Auth)
ANTHROPIC_API_KEY=
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

# Optional: required to encrypt credentials when connecting Moloni ON.
# 32 random bytes encoded as 64 hexadecimal characters. Never rotate casually.
APP_ENC_KEY=

# Optional: proforma delivery and internal notifications via Postmark.
POSTMARK_OUTBOUND_TOKEN=

# Application origin. Use the real HTTPS origin in production.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional automation; leave blank when n8n is not configured.
N8N_WEBHOOK_URL=

# Moloni credentials and tax IDs are configured per company in /settings.
# Do not add private keys to NEXT_PUBLIC_* variables.
